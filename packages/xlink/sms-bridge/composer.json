{
    "name": "xlink/sms-bridge",
    "description": "A simple and extensible SMS gateway bridge for Laravel supporting multiple providers.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "X-Link LTD",
            "role": "Maintainer of X-Link internal fork"
        }
    ],
    "require": {
        "php": ">=8.0",
        "illuminate/support": ">=8.0",
        "illuminate/database": ">=8.0",
        "illuminate/routing": ">=8.0",
        "guzzlehttp/guzzle": "^7.2"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.5|^10.0"
    },
    "autoload": {
        "psr-4": {
            "XLink\\SmsBridge\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XLink\\SmsBridge\\Providers\\SmsBridgeServiceProvider"
            ],
            "aliases": {
                "SmsBridge": "XLink\\SmsBridge\\Facades\\SmsBridge"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "version": "1.0.0"
}
